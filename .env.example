# Copy this file to .env and fill in the values. Restart the server after changes.

# ---------- App & login ----------
# Long random string used to protect login codes and sessions (required, at least 32
# characters: the server refuses to start without it).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
# Work emails that are administrators (comma separated). They can log in even
# before they are added on the "Ekipi" page.
ADMIN_EMAILS=
# Strongly recommended: only these email domains may log in (e.g. anchorzup.com)
ALLOWED_EMAIL_DOMAINS=
# Address used in email links
APP_URL=http://127.0.0.1:8000

# ---------- Email (any SMTP service) ----------
# Without SMTP_USER/SMTP_PASSWORD nothing is sent: emails appear on the
# "Emails sent" page and nobody can sign in (codes can't be sent).
# DEV_LOGIN_CODES=1 fills the code in on the page instead: ONLY for testing on this
# computer (refused when APP_URL is not 127.0.0.1/localhost). Never in real use.
DEV_LOGIN_CODES=0
#
# Gmail: SMTP_PASSWORD is a Google "App password" (Google account > Security >
# 2-Step Verification > App passwords), not the normal password.
#   SMTP_HOST=smtp.gmail.com
#
# Brevo (free: 300 emails/day): Brevo > SMTP & API > SMTP. SMTP_USER is the
# "Login" shown there (…@smtp-brevo.com), SMTP_PASSWORD is an SMTP key.
# MAIL_FROM is required and must be a sender verified in Brevo (Senders & IP).
#   SMTP_HOST=smtp-relay.brevo.com
#   MAIL_FROM=SyncUp <you@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Hour of the day (0-23) after which the daily reminder goes to each PM
REMINDER_HOUR=8

# ---------- Jira Cloud ----------
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://kompania.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_ISSUE_TYPE=Task
# 1 (default) = after each meeting, tasks that have a person become draft tickets by themselves
# ("Tickets to send"). They still go to Jira only when the PM sends them. 0 = make tickets by hand.
AUTO_TICKETS=1
# 1 (default) = the standup report reads each team member's current Jira issues (key, title and
# status only, no descriptions) and SyncUp tickets, so half-heard words are matched to the right
# work. These titles are sent to the AI provider with the transcript. 0 = off.
STANDUP_WORK_CONTEXT=1

# ---------- AI ----------
# Claude API key for summaries, decisions and tasks (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# HuggingFace token for speaker diarization (https://huggingface.co/settings/tokens)
HF_TOKEN=
# CPU threads for Whisper (empty = 4). On laptops with fast and slow cores more threads is slower;
# raise it only on a desktop CPU with many fast cores, and measure.
WHISPER_THREADS=

# Free alternative for testing (used when ANTHROPIC_API_KEY is empty).
# Key: https://console.groq.com/keys   Note: transcripts are sent to Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Force a provider: anthropic or groq (empty = Claude if its key exists, else Groq)
LLM_PROVIDER=

# ---------- Google Calendar (optional, read only) ----------
# Each PM connects their own calendar (Home -> "Connect Google Calendar"); a new meeting is
# then filled in from a calendar event, and the side assistant creates online meetings with a
# Google Meet link (Google emails the invitations). The app READS events and manages only the
# events in its own calendar "SyncUp meetings": it can never change the PM's other calendars.
# Google Cloud Console -> new project -> "Google Calendar API" enabled -> OAuth consent screen
# (add the PMs' Gmail addresses as test users) -> Credentials -> OAuth client ID, type
# "Web application", Authorized redirect URI = APP_URL + /api/calendar/callback
# (e.g. http://127.0.0.1:8000/api/calendar/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
