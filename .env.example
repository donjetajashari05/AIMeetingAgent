# Copy this file to .env and fill in the values. Restart the server after changes.

# ---------- App & login ----------
# Long random string used to protect login codes and sessions.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
# Work emails that are administrators (comma separated). They can log in even
# before they are added on the "Ekipi" page.
ADMIN_EMAILS=
# Optional: only these email domains may log in (e.g. anchorzup.com)
ALLOWED_EMAIL_DOMAINS=
# Address used in email links
APP_URL=http://127.0.0.1:8000

# ---------- Email (Google Workspace / Gmail) ----------
# SMTP_PASSWORD is a Google "App password" (Google account > Security >
# 2-Step Verification > App passwords), not the normal password.
# Without SMTP_USER/SMTP_PASSWORD nothing is sent: emails appear on the
# "Njoftimet" page and login codes are printed in the server terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Hour of the day (0-23) after which the daily reminder goes to each PM
REMINDER_HOUR=8

# ---------- Jira Cloud ----------
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://kompania.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_ISSUE_TYPE=Task

# ---------- AI ----------
# Claude API key for summaries, decisions and tasks (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# HuggingFace token for speaker diarization (https://huggingface.co/settings/tokens)
HF_TOKEN=
